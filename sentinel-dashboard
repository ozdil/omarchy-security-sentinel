#!/bin/bash -p
set -euo pipefail

# Immediate rejection of loader injection
if [ -n "${LD_PRELOAD:-}" ] || [ -n "${LD_LIBRARY_PATH:-}" ]; then
    echo "Security Error: Prohibited loader control variable detected" >&2
    exit 1
fi

# Re-exec through fixed trusted shell under sanitized environment (/usr/bin/env -i)
if [ "${SENTINEL_SECURE_ENV:-0}" != "1" ]; then
    exec /usr/bin/env -i \
        PATH="/usr/bin:/bin:${HOME}/.local/bin:${HOME}/.cargo/bin" \
        HOME="${HOME}" \
        USER="${USER:-$(/usr/bin/id -un 2>/dev/null || echo "user")}" \
        LANG="${LANG:-C.UTF-8}" \
        LC_ALL="${LC_ALL:-C.UTF-8}" \
        DISPLAY="${DISPLAY:-}" \
        WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-}" \
        XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(/usr/bin/id -u 2>/dev/null || echo 1000)}" \
        XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-${HOME}/.config}" \
        XDG_CACHE_HOME="${XDG_CACHE_HOME:-${HOME}/.cache}" \
        DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-}" \
        XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-}" \
        XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-}" \
        HYPRLAND_INSTANCE_SIGNATURE="${HYPRLAND_INSTANCE_SIGNATURE:-}" \
        SENTINEL_SECURE_ENV=1 \
        /bin/bash -p "$0" "$@"
fi

# Reject unexpected build and loader controls
for var in LD_PRELOAD LD_LIBRARY_PATH RUSTC_WRAPPER CARGO_BUILD_RUSTC_WRAPPER RUSTFLAGS CARGO_ENCODED_RUSTFLAGS CARGO_HOME BASH_ENV ENV; do
    if [ -n "${!var+x}" ]; then
        echo "Security Error: Prohibited build/loader control variable detected: ${var}" >&2
        exit 1
    fi
done

DIR="$(cd "$(/usr/bin/dirname "$(/usr/bin/realpath "${BASH_SOURCE[0]}")")" && /usr/bin/pwd)"

# Resolve trusted quickshell binary
QUICKSHELL_BIN=""
if [[ -x /usr/bin/quickshell ]]; then
    QUICKSHELL_BIN="/usr/bin/quickshell"
elif [[ -x /usr/local/bin/quickshell ]]; then
    QUICKSHELL_BIN="/usr/local/bin/quickshell"
elif [[ -x "${HOME}/.local/bin/quickshell" ]]; then
    QUICKSHELL_BIN="${HOME}/.local/bin/quickshell"
fi

# Prefer native Quickshell standalone UI if available
if [[ "${1:-}" != "--cli" && -n "${QUICKSHELL_BIN}" ]]; then
    QML_SHELL="${DIR}/qml/shell.qml"
    # Packaged installs put this script in /usr/bin and the QML in the package's own dir
    if [[ ! -f "${QML_SHELL}" ]]; then
        QML_SHELL="/usr/share/omarchy-security-sentinel/qml/shell.qml"
    fi
    if [[ -f "${QML_SHELL}" ]]; then
        # Bring an open dashboard forward instead of starting a second instance.
        # Without --path, ipc talks to the 'default' config, never this one.
        if "${QUICKSHELL_BIN}" ipc --path "${QML_SHELL}" call ozdil.sentinel show >/dev/null 2>&1; then
            exit 0
        fi
        exec "${QUICKSHELL_BIN}" -p "${QML_SHELL}"
    fi
fi

if [[ "${1:-}" == "--cli" ]]; then
    shift
fi

BIN="${DIR}/sentinel-engine"
if [[ -x "${BIN}" ]]; then
    "${BIN}" "$@"
elif [[ ! -f "${DIR}/Cargo.toml" ]]; then
    echo "Error: sentinel-engine not found next to ${BASH_SOURCE[0]} and no source tree to build from" >&2
    exit 1
else
    echo "Building sentinel-engine from source..." >&2
    (cd "${DIR}" && cargo build --release --locked && install -m 755 "${DIR}/target/release/sentinel-engine" "${BIN}")
    "${BIN}" "$@"
fi
